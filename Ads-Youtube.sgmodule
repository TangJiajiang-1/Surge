#!name=Ads-Youtube
#!desc=Ads-Youtube
#!category=Ads-Youtube
#!arguments=block_upload:true,block_shorts:false,auto_hd:true,block_games:true,block_vertical_live:false,jump_ahead:true,block_store:true,block_ai:true,on_the_go:true
#!arguments-desc=block_upload\n  └ Remove upload tab\nblock_shorts\n  └ Remove Shorts tab\nauto_hd\n  └ Prefer highest offered resolution; Premium bitrate when authorized\nblock_games\n  └ Remove Playables on homepage\nblock_vertical_live\n  └ Remove Vertical live on homepage\njump_ahead\n  └  Enable Jump Ahead button\nblock_store\n  └  Remove creator stores, product cards and overlays\nblock_ai\n  └ Remove Ask, AI summaries and related controls\non_the_go\n  └ On-the-go controls when compatible UI components are available
#!requirement=SYSTEM = 'iOS'

[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Surge/refs/heads/main/Youtube%20response.js,argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}}}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Surge/refs/heads/main/Youtube%20request.js,argument="{"captionLang":"{{{字幕翻译语言}}}"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Surge/refs/heads/main/Youtube%20request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
