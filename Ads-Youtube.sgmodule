#!name = Ads-Youtube
#!desc = Ads-Youtube
#!author = Maasea (Loon 原版) / Surge 转换版
#!icon = https://github.com/ishowshu/loon/raw/refs/heads/main/icon/youtube.png
#!system = iOS

[Argument]
captionLang = select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag=字幕翻译语言, default="zh-Hans"
blockUpload = switch, false, tag=屏蔽上传按钮
blockImmersive = switch, false, tag=屏蔽选段按钮
blockShorts = switch, false, tag=屏蔽Shorts按钮
debug = switch, false, tag=启用调试模式

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$ requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,tag=protobuf,argument=[{captionLang},{blockUpload},{blockImmersive},{blockShorts},{debug}]
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Egern/refs/heads/main/Youtube.js,tag=youtube.request.init,argument=[{captionLang}]
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Egern/refs/heads/main/Youtube.js,tag=youtube.request.log_event

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
