#!name = Amap
#!desc = 高德地图去广告 / 页面精简（需卸载重装才能生效）
#!author = 树先生 (Loon 原版) / Surge 转换版
#!icon = https://github.com/ishowshu/loon/raw/refs/heads/main/icon/gaode.png
#!date = 2026-10-31
#!system = iOS

[Rule]
AND,((URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch"),(USER-AGENT,"AMapiPhone*")),REJECT

[URL Rewrite]
^https:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource\/home - reject-dict
^https:\/\/ai\.amap\.com\/v1\/ai_rec\/home_qs - reject-dict
^https:\/\/m5\.amap\.com\/ws\/info_bff\/rankingCard - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/order\/car\/remark\/satisfactionConf - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/pay\/web\/paySuccess\/info\/request - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/order\/car\/feedback\/get_card_questions - reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured - reject-dict
^https:\/\/render\.amap\.com\/ws\/render\/api\/data - reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/fluorite\/resource - reject-dict
^https:\/\/m5\.amap\.com\/ws\/aos\/activity\/bus\/sign\/task - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/transportation\/diversion\/resource\/driving - reject-dict
^https:\/\/m5\.amap\.com\/ws\/aos_public_travel\/recommend_plan - reject-dict
^https:\/\/ai\.amap\.com\/v1\/ai_rec\/nav_start - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/transportation\/diversion\/resource\/bus_only_refresh - reject-dict
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-assets - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource - reject-dict

[Map Local]
^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource data-type=text data="" status-code=200
^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend data-type=text data="" status-code=200
^https:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen\? data-type=text data="" status-code=200
^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\? data-type=text data="" status-code=200
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-aiqs data-type=text data="" status-code=200

[Script]
http-response ^https:\/\/m5-zb\.amap\.com\/ws\/boss\/car\/order\/content_info requires-body=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Egern/refs/heads/main/amap.js,tag=打车页面图标菜单
http-response ^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail requires-body=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Egern/refs/heads/main/amap.js,tag=搜索打开目的地详情的广告
http-response ^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/search\/sp requires-body=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Egern/refs/heads/main/amap.js,tag=搜索结果列表
http-response ^https:\/\/m5\.amap\.com\/ws\/info_bff\/tradeUnionPortal requires-body=1,script-path=https://raw.githubusercontent.com/TangJiajiang-1/Egern/refs/heads/main/amap.js,tag=酒店页面广告

[MITM]
hostname = %APPEND% m5.amap.com, amap-aos-info-nogw.amap.com, m5-zb.amap.com, info.amap.com, ai.amap.com, render.amap.com
